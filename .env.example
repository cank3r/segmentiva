# Segmentiva environment variables (example)
#
# During local development these are normally injected automatically by the
# Shopify CLI when you run `npm run dev` (`shopify app dev`). Copy this file to
# `.env` only if you need to run the built server directly (`npm run start`).
# NEVER commit real values, tokens, or customer data.

# Shopify app credentials (from the Shopify Partner/Dev Dashboard app record)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public URL the app is served from (the CLI sets this to the dev tunnel URL)
SHOPIFY_APP_URL=http://localhost:3000

# Comma-separated Admin API access scopes (kept in sync with shopify.app.toml)
SCOPES=read_customers,write_customers

# Optional: custom shop domain override used by some dev setups
# SHOP_CUSTOM_DOMAIN=

# Local SQLite (official template). Shared environments should use PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/segmentiva
DATABASE_URL=file:dev.sqlite

# Optional: local server port (defaults to 3000)
# PORT=3000
