// PostgreSQL schema for shared and production environments.
// Keep models in sync with prisma/schema.prisma (SQLite local development).
// Select this file by setting a postgresql:// DATABASE_URL and running
// Prisma through scripts/prisma-with-db.mjs — do not change only the URL
// while pointing at the SQLite schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum ShopInstallationState {
  INSTALLED
  UNINSTALLED
}

enum WebhookDeliveryStatus {
  PENDING
  COMPLETED
}

model Shop {
  id                String                 @id @default(cuid())
  shopDomain        String                 @unique
  installationState ShopInstallationState
  installedAt       DateTime
  uninstalledAt     DateTime?
  installGeneration Int                    @default(0)

  defaultLocale         String?
  accountCompatibility  String?
  lastDiagnosticStatus  String?
  lastDiagnosticAt      DateTime?
  lastDiagnosticSummary Json?
  pilotSeedPackId       String?
  pilotSeedImportedAt   DateTime?
  pilotSeedVersion      String?
  pilotSeedStatus       String?
  pilotSeedDefinition   Json?

  publishedQuestionnaireId String?
  publishedVersion         Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model ProcessedWebhook {
  id          String                @id @default(cuid())
  shopDomain  String
  topic       String
  webhookId   String
  status      WebhookDeliveryStatus @default(PENDING)
  claimedAt   DateTime              @default(now())
  completedAt DateTime?
  createdAt   DateTime              @default(now())

  @@unique([shopDomain, webhookId])
  @@index([shopDomain])
}
