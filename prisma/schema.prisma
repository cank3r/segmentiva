// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Local development uses SQLite. Shared/production environments use the
// PostgreSQL schema at prisma/postgresql/schema.prisma. Switching only
// DATABASE_URL is not enough — run Prisma through scripts/prisma-with-db.mjs
// (npm run setup) so the matching schema and migration history are selected.
// Keep this file's models in sync with prisma/postgresql/schema.prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Official Shopify session storage model. Do not duplicate access tokens on Shop.
// Required by @shopify/shopify-app-session-storage-prisma.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum ShopInstallationState {
  INSTALLED
  UNINSTALLED
}

enum WebhookDeliveryStatus {
  PENDING
  COMPLETED
}

model Shop {
  id                String                 @id @default(cuid())
  shopDomain        String                 @unique
  installationState ShopInstallationState
  installedAt       DateTime
  uninstalledAt     DateTime?
  installGeneration Int                    @default(0)

  defaultLocale         String?
  accountCompatibility  String?
  lastDiagnosticStatus  String?
  lastDiagnosticAt      DateTime?
  lastDiagnosticSummary Json?
  pilotSeedPackId       String?
  pilotSeedImportedAt   DateTime?
  pilotSeedVersion      String?
  pilotSeedStatus       String?
  pilotSeedDefinition   Json?

  publishedQuestionnaireId String?
  publishedVersion         Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// Idempotency key for HMAC-verified Shopify webhook deliveries.
// Stores only shop domain, topic, webhook id, and delivery status — never the payload.
// Only COMPLETED deliveries are treated as duplicates; PENDING rows are resumed.
model ProcessedWebhook {
  id          String                @id @default(cuid())
  shopDomain  String
  topic       String
  webhookId   String
  status      WebhookDeliveryStatus @default(PENDING)
  claimedAt                DateTime              @default(now())
  completedAt              DateTime?
  claimedInstallGeneration Int?
  claimedTriggeredAt       DateTime?
  sessionFingerprints      Json?
  createdAt                DateTime              @default(now())

  @@unique([shopDomain, webhookId])
  @@index([shopDomain])
}
